# Required in production. Set to the exact public HTTPS origin without any path.
APP_ORIGIN=http://localhost:3000
# Put this on a persistent, private writable volume in production.
DATABASE_PATH=./data/relay.sqlite

# Optional.
APP_NAME=Relay
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Optional server-only OpenAI integration. Paste workflows work without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_WORKSPACE_DAILY_LIMIT=20
AI_INSTALLATION_DAILY_LIMIT=100

# Required only for the one-time operator bootstrap command or BOOTSTRAP_ON_START.
# Set through your shell or secrets manager. Keep these out of source and unset after use.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_WORKSPACE=Pilot Workspace
BOOTSTRAP_ON_START=0

# Use 1 for public email/password registration. Leave 0 for an invite-only pilot.
AUDIT_PUBLIC_SIGNUP=0
# Optional on the initial bootstrap. Grants this one real account report previews.
BOOTSTRAP_AUDIT_TESTER=0

# Optional Stripe membership. Fill all four values or leave all blank.
# Set up recurring USD prices for $12 per month and $99 per year.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE=
STRIPE_ANNUAL_PRICE=

# Used only by the Caddy Docker Compose deployment.
DEPLOY_DOMAIN=
